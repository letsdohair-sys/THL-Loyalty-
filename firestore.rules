rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    // The walk-up check-in kiosk. No PIN is typed at the kiosk, so this
    // claim is handed out to anyone who opens the check-in screen - it is
    // therefore scoped to exactly what punching a loyalty card needs and
    // nothing else. Deliberately NOT a stand-in for admin.
    function isKiosk() {
      return isSignedIn() && request.auth.token.kiosk == true;
    }

    // clients/{clientId} - doc ID equals the signed-in client's uid (custom
    // token is minted with uid == clients doc ID by the clientLogin function).
    match /clients/{clientId} {
      // The kiosk needs the name/phone list to show "tap your name". It
      // gets read only - it can never create, edit or delete a client.
      allow read: if isOwner(clientId) || isAdmin() || isKiosk();
      // Clients may only touch a narrow self-service field set (loyalty
      // redemption, PIN changes, etc. all stay admin-driven in the current
      // app - the client app never writes its own client doc today).
      allow write: if isAdmin();
    }

    // records/{recordId} - visit history, has a clientId field.
    // Every write path in the app today is admin-driven (check-in, add
    // visit, edit notes, delete) - clients only ever read their own.
    match /records/{recordId} {
      allow read: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid || isAdmin() || isKiosk());
      // The kiosk creates the stub "Checked in" record and nothing else:
      // no services, no prices, no notes beyond the stub, and it is always
      // flagged viaCheckin so it shows up in Awaiting Checkout. Filling in
      // the real visit details is an update, and stays admin-only.
      allow create: if isAdmin() || (
        isKiosk() &&
        request.resource.data.viaCheckin == true &&
        request.resource.data.services.size() == 0 &&
        request.resource.data.keys().hasOnly(
          ['clientId', 'date', 'notes', 'photos', 'services', 'viaCheckin'])
      );
      allow update, delete: if isAdmin();
    }

    // hairChecks/{checkId} - clients submit their own "hair check" quiz
    // from their own dashboard; admin can read/manage all.
    match /hairChecks/{checkId} {
      allow read: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.clientId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // slots/{slotId} - availability calendar. Admin manages freely.
    // A signed-in client may only claim an OPEN slot for themselves,
    // and only change the booking fields - never the date/time, and
    // never someone else's booking.
    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.isBooked == false &&
        request.resource.data.isBooked == true &&
        request.resource.data.clientId == request.auth.uid &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.time == resource.data.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isBooked', 'clientId', 'clientName', 'service'])
      );
    }

    // services/{serviceId} - service catalog, read by clients (booking) and
    // admin (management); only admin edits it.
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // trends/{trendId} - hair trend cards shown on the client dashboard.
    match /trends/{trendId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // settings/config - business config (loyalty threshold, weekly
    // schedule, check-in counters, licenses...). No secrets live here
    // anymore (the admin PIN lives in the locked-down `secure` collection
    // below) - safe for any signed-in user to read, admin-only to write.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // The kiosk advances the golden-guest counter on each check-in. It
      // may touch those two fields and nothing else - not the loyalty
      // threshold, the schedule, the licences or anything else in here.
      allow update: if isAdmin() || (
        isKiosk() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['checkinCounter', 'lastMilestoneWinner'])
      );
    }

    // secure/* - admin credentials. Never touched by client SDKs; only
    // Cloud Functions (via the Admin SDK, which bypasses these rules
    // entirely) read or write here.
    match /secure/{docId} {
      allow read, write: if false;
    }

    // Default-deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
